# Backend Configuration
PROJECT_NAME="Python RAG Chatbot"
API_V1_STR="/api"

# Database Configuration (Defaults to SQLite for instant local testing)
DATABASE_URL=sqlite:///./python_rag.db

# Security & JWT
JWT_SECRET_KEY=your_jwt_secret_key_minimum_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Groq LLM API Key (Get free key from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Vector DB & Embeddings
CHROMA_DB_DIR=./chroma_db
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# Environment Mode
ENVIRONMENT=development
